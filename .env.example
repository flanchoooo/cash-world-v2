# Copy to .env and set the existing database connection. No database container is started.
DB_URL=jdbc:mysql://your-database-host:3306/wallet?connectionTimeZone=UTC
DB_USER=your-database-user
DB_PASSWORD=your-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-change-me
JWT_SECRET=development-only-secret-at-least-32-bytes-change-me
APP_PORT=8011
ADMIN_PORT=8089
BACKEND_URL=http://backend:8011
PUBLIC_BASE_URL=http://localhost:8011
REMITTANCE_RATES=USD:BWP=13.500000
